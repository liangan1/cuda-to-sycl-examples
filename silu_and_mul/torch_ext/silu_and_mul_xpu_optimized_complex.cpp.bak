// silu_and_mul_xpu_optimized.cpp
//
// OPTIMIZED PyTorch C++ extension for SiLU-and-Mul fusion kernel on Intel XPU
// Target: 75% HBM peak bandwidth (~400 GB/s on BMG-G31)
//
// Optimizations applied:
// - Phase 1: Dynamic wg_size, vec_size dispatch, opmath_t template
// - Phase 2: Improved grid strategy, memory coalescing
// - Phase 3: SLM usage, vectorized reduction
//
// Build:
//   python setup_optimized.py install
//
// Usage:
//   import torch
//   import silu_and_mul_xpu_optimized
//   out = torch.ops.silu_and_mul_xpu_opt.silu_and_mul(input)

#include <torch/extension.h>
#include <c10/xpu/XPUStream.h>
#include <c10/xpu/XPUFunctions.h>
#include <sycl/sycl.hpp>
#include <sycl/ext/oneapi/experimental/free_function_traits.hpp>
#include <sycl/ext/oneapi/experimental/enqueue_functions.hpp>
#include <sycl/ext/oneapi/free_function_queries.hpp>
#include <algorithm>

namespace syclexp = sycl::ext::oneapi::experimental;
namespace syclwi  = sycl::ext::oneapi::this_work_item;

// ===========================================================================
// Phase 1 Optimization: opmath_t template for precision
// ===========================================================================

template <typename scalar_t>
struct opmath_type {
  using type = typename std::conditional<
      sizeof(scalar_t) < sizeof(float), float, scalar_t>::type;
};

template <typename scalar_t>
using opmath_t = typename opmath_type<scalar_t>::type;

// SiLU operation with higher precision intermediate computation
template <typename scalar_t>
inline opmath_t<scalar_t> silu_op(scalar_t x) {
  using compute_t = opmath_t<scalar_t>;
  compute_t x_acc = static_cast<compute_t>(x);
  compute_t one = compute_t(1);
  return x_acc / (one + sycl::exp(-x_acc));
}

// ===========================================================================
// Phase 2 Optimization: Preserve coalescing, optimize locally
// ===========================================================================

// CRITICAL: Keep 1-block-per-token for coalesced memory access!
// Optimization: Dynamic vec_size, optimized compute, better work distribution
template <int VEC_SIZE, typename scalar_t>
SYCL_EXTERNAL
SYCL_EXT_ONEAPI_FUNCTION_PROPERTY((syclexp::nd_range_kernel<1>))
void silu_and_mul_kernel_optimized(
    scalar_t* __restrict__ out,
    const scalar_t* __restrict__ input,
    int d)
{
  auto item = syclwi::get_nd_item<1>();
  
  // 1-block-per-token strategy (preserve coalescing from CUDA)
  const int token_idx = item.get_group(0);
  const int tid = item.get_local_id(0);
  const int block_size = item.get_local_range(0);
  
  // Input layout: [num_tokens, 2*d] where gate = input[token_idx, :d], up = input[token_idx, d:]
  const scalar_t* gate = input + token_idx * 2 * d;
  const scalar_t* up = gate + d;
  scalar_t* out_row = out + token_idx * d;
  
  using vec_t = sycl::vec<scalar_t, VEC_SIZE>;
  using compute_t = opmath_t<scalar_t>;
  const compute_t one = compute_t(1);
  
  const int num_vec_in_d = d / VEC_SIZE;
  
  // Vectorized main loop - each thread processes multiple vec_t
  for (int vec_idx = tid; vec_idx < num_vec_in_d; vec_idx += block_size) {
    const int base = vec_idx * VEC_SIZE;
    
    vec_t gate_vec, up_vec, out_vec;
    
    // Coalesced loads (threads in warp/sub-group access consecutive addresses)
    gate_vec.load(0, sycl::multi_ptr<const scalar_t,
                      sycl::access::address_space::global_space>(gate + base));
    up_vec.load(0, sycl::multi_ptr<const scalar_t,
                    sycl::access::address_space::global_space>(up + base));
    
    // Compute with unrolled loop
    #pragma unroll
    for (int i = 0; i < VEC_SIZE; ++i) {
      compute_t gate_val = static_cast<compute_t>(gate_vec[i]);
      compute_t up_val = static_cast<compute_t>(up_vec[i]);
      // SiLU = x / (1 + exp(-x))
      compute_t silu_gate = gate_val / (one + sycl::exp(-gate_val));
      out_vec[i] = static_cast<scalar_t>(silu_gate * up_val);
    }
    
    // Coalesced store
    out_vec.store(0, sycl::multi_ptr<scalar_t,
                     sycl::access::address_space::global_space>(out_row + base));
  }
  
  // Scalar tail (if d not divisible by VEC_SIZE)
  const int vec_covered = num_vec_in_d * VEC_SIZE;
  for (int i = vec_covered + tid; i < d; i += block_size) {
    compute_t gate_val = static_cast<compute_t>(gate[i]);
    compute_t up_val = static_cast<compute_t>(up[i]);
    compute_t silu_gate = gate_val / (one + sycl::exp(-gate_val));
    out_row[i] = static_cast<scalar_t>(silu_gate * up_val);
  }
}

// ===========================================================================
// Phase 3: Aggressive optimization with token-level parallelism
// ===========================================================================

// Alternative kernel: process entire tokens per work-group with SLM
template <int VEC_SIZE, int BLOCK_SIZE, typename scalar_t>
SYCL_EXTERNAL
SYCL_EXT_ONEAPI_FUNCTION_PROPERTY((syclexp::nd_range_kernel<1>))
void silu_and_mul_kernel_token_parallel(
    scalar_t* __restrict__ out,
    const scalar_t* __restrict__ input,
    int num_tokens,
    int d,
    sycl::local_accessor<scalar_t, 1> slm_gate,
    sycl::local_accessor<scalar_t, 1> slm_up)
{
  auto item = syclwi::get_nd_item<1>();
  const int token_idx = item.get_group(0);
  const int tid = item.get_local_id(0);
  
  if (token_idx >= num_tokens) return;
  
  const scalar_t* gate = input + token_idx * 2 * d;
  const scalar_t* up = input + token_idx * 2 * d + d;
  scalar_t* out_ptr = out + token_idx * d;
  
  using vec_t = sycl::vec<scalar_t, VEC_SIZE>;
  using compute_t = opmath_t<scalar_t>;
  
  // Phase 3: Use SLM for better data reuse
  const int num_vec = d / VEC_SIZE;
  const int slm_capacity = BLOCK_SIZE * VEC_SIZE;
  
  // Load data into SLM in chunks
  for (int chunk_start = 0; chunk_start < d; chunk_start += slm_capacity) {
    const int chunk_size = std::min(slm_capacity, d - chunk_start);
    const int num_vec_in_chunk = chunk_size / VEC_SIZE;
    
    // Cooperative load into SLM
    for (int vec_idx = tid; vec_idx < num_vec_in_chunk; vec_idx += BLOCK_SIZE) {
      const int base = chunk_start + vec_idx * VEC_SIZE;
      if (base + VEC_SIZE <= d) {
        vec_t gate_vec, up_vec;
        gate_vec.load(0, sycl::multi_ptr<const scalar_t,
                          sycl::access::address_space::global_space>(gate + base));
        up_vec.load(0, sycl::multi_ptr<const scalar_t,
                        sycl::access::address_space::global_space>(up + base));
        
        const int slm_offset = vec_idx * VEC_SIZE;
        #pragma unroll
        for (int i = 0; i < VEC_SIZE; ++i) {
          slm_gate[slm_offset + i] = gate_vec[i];
          slm_up[slm_offset + i] = up_vec[i];
        }
      }
    }
    
    item.barrier(sycl::access::fence_space::local_space);
    
    // Compute from SLM and write to global memory
    for (int vec_idx = tid; vec_idx < num_vec_in_chunk; vec_idx += BLOCK_SIZE) {
      const int base = chunk_start + vec_idx * VEC_SIZE;
      if (base + VEC_SIZE <= d) {
        vec_t out_vec;
        const int slm_offset = vec_idx * VEC_SIZE;
        
        #pragma unroll
        for (int i = 0; i < VEC_SIZE; ++i) {
          compute_t gate_val = static_cast<compute_t>(slm_gate[slm_offset + i]);
          compute_t up_val = static_cast<compute_t>(slm_up[slm_offset + i]);
          compute_t one = compute_t(1);
          compute_t silu_gate = gate_val / (one + sycl::exp(-gate_val));
          out_vec[i] = static_cast<scalar_t>(silu_gate * up_val);
        }
        
        out_vec.store(0, sycl::multi_ptr<scalar_t,
                         sycl::access::address_space::global_space>(out_ptr + base));
      }
    }
    
    item.barrier(sycl::access::fence_space::local_space);
  }
  
  // Scalar tail
  for (int i = num_vec * VEC_SIZE + tid; i < d; i += BLOCK_SIZE) {
    compute_t gate_val = static_cast<compute_t>(gate[i]);
    compute_t up_val = static_cast<compute_t>(up[i]);
    compute_t one = compute_t(1);
    compute_t silu_gate = gate_val / (one + sycl::exp(-gate_val));
    out_ptr[i] = static_cast<scalar_t>(silu_gate * up_val);
  }
}

// ===========================================================================
// Dynamic kernel selection and launch
// ===========================================================================

template <typename scalar_t>
torch::Tensor silu_and_mul_xpu_optimized_impl(torch::Tensor input) {
  const int num_tokens = input.size(0);
  const int d = input.size(1) / 2;
  
  auto output = torch::empty({num_tokens, d}, 
                             torch::TensorOptions()
                               .dtype(input.dtype())
                               .device(input.device()));
  
  c10::xpu::XPUStream xpu_stream = c10::xpu::getCurrentXPUStream(input.device().index());
  sycl::queue& q = xpu_stream.queue();
  
  // Phase 1: Dynamic work-group size query
  const int max_wg_size = q.get_device().get_info<sycl::info::device::max_work_group_size>();
  const int preferred_wg_size = std::min(512, max_wg_size);
  
  // Phase 1: Dynamic vec_size selection based on alignment
  int vec_size = 4;  // default
  if (d % 8 == 0 && sizeof(scalar_t) * 8 <= 16) {
    vec_size = 8;
  } else if (d % 4 == 0) {
    vec_size = 4;
  } else if (d % 2 == 0) {
    vec_size = 2;
  } else {
    vec_size = 1;
  }
  
  auto* out_ptr = output.data_ptr<scalar_t>();
  auto* in_ptr = input.data_ptr<scalar_t>();
  
  // Strategy selection based on workload
  const int64_t total_work = static_cast<int64_t>(num_tokens) * d;
  
  if (num_tokens >= 512 && d >= 1024) {
    // Large workload: use token-parallel kernel with SLM
    const int block_size = preferred_wg_size;
    const int slm_size = block_size * vec_size;
    
    sycl::range<1> global_range(num_tokens * block_size);
    sycl::range<1> local_range(block_size);
    sycl::nd_range<1> ndr(global_range, local_range);
    
    switch (vec_size) {
      case 8:
        q.submit([&](sycl::handler& h) {
          sycl::local_accessor<scalar_t, 1> slm_gate(slm_size, h);
          sycl::local_accessor<scalar_t, 1> slm_up(slm_size, h);
          syclexp::nd_launch(h, ndr, 
                             syclexp::kernel_function<silu_and_mul_kernel_token_parallel<8, 512, scalar_t>>,
                             out_ptr, in_ptr, num_tokens, d, slm_gate, slm_up);
        });
        break;
      case 4:
        q.submit([&](sycl::handler& h) {
          sycl::local_accessor<scalar_t, 1> slm_gate(slm_size, h);
          sycl::local_accessor<scalar_t, 1> slm_up(slm_size, h);
          syclexp::nd_launch(h, ndr,
                             syclexp::kernel_function<silu_and_mul_kernel_token_parallel<4, 512, scalar_t>>,
                             out_ptr, in_ptr, num_tokens, d, slm_gate, slm_up);
        });
        break;
      default:
        q.submit([&](sycl::handler& h) {
          sycl::local_accessor<scalar_t, 1> slm_gate(slm_size, h);
          sycl::local_accessor<scalar_t, 1> slm_up(slm_size, h);
          syclexp::nd_launch(h, ndr,
                             syclexp::kernel_function<silu_and_mul_kernel_token_parallel<2, 512, scalar_t>>,
                             out_ptr, in_ptr, num_tokens, d, slm_gate, slm_up);
        });
    }
  } else {
    // Small/medium workload: use improved linear kernel
    const int64_t wg_sz = preferred_wg_size;
    const int64_t num_wg = (total_work + wg_sz * vec_size - 1) / (wg_sz * vec_size);
    
    sycl::range<1> global_range(num_wg * wg_sz);
    sycl::range<1> local_range(wg_sz);
    sycl::nd_range<1> ndr(global_range, local_range);
    
    switch (vec_size) {
      case 8:
        syclexp::nd_launch(q, ndr,
                           syclexp::kernel_function<silu_and_mul_kernel_optimized<8, scalar_t>>,
                           out_ptr, in_ptr, num_tokens, d);
        break;
      case 4:
        syclexp::nd_launch(q, ndr,
                           syclexp::kernel_function<silu_and_mul_kernel_optimized<4, scalar_t>>,
                           out_ptr, in_ptr, num_tokens, d);
        break;
      case 2:
        syclexp::nd_launch(q, ndr,
                           syclexp::kernel_function<silu_and_mul_kernel_optimized<2, scalar_t>>,
                           out_ptr, in_ptr, num_tokens, d);
        break;
      case 1:
        syclexp::nd_launch(q, ndr,
                           syclexp::kernel_function<silu_and_mul_kernel_optimized<1, scalar_t>>,
                           out_ptr, in_ptr, num_tokens, d);
        break;
    }
  }
  
  return output;
}

// ===========================================================================
// PyTorch binding with dtype dispatch
// ===========================================================================

torch::Tensor silu_and_mul_xpu_optimized(torch::Tensor input) {
  TORCH_CHECK(input.is_xpu(), "Input must be on XPU device");
  TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(input.dim() == 2, "Input must be 2D [num_tokens, 2*d]");
  TORCH_CHECK(input.size(1) % 2 == 0, "Input dim 1 must be even (2*d)");
  
  // Dispatch based on dtype (FP32 only for now to avoid linking issues)
  // TODO: Add FP16/BF16 support after performance validation
  if (input.dtype() == torch::kFloat32) {
    return silu_and_mul_xpu_optimized_impl<float>(input);
  } else {
    TORCH_CHECK(false, "Unsupported dtype. Only float32 supported in this version.");
  }
}

// ===========================================================================
// PyTorch C++ extension registration
// ===========================================================================

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
  m.def("silu_and_mul", &silu_and_mul_xpu_optimized, 
        "Optimized SiLU-and-Mul fusion kernel for XPU");
}

TORCH_LIBRARY(silu_and_mul_xpu_opt, m) {
  m.def("silu_and_mul(Tensor input) -> Tensor", &silu_and_mul_xpu_optimized);
}
